version: '3.8'

services:
  logic_engine:
    build: 
      context: .
      dockerfile: Dockerfile.backend
    ports:
      - "8000:8000"
    environment:
      - GEMINI_API_KEY=${GEMINI_API_KEY}
      - REDIS_URL=redis://cache:6379/0
    depends_on:
      - cache

  cache:
    image: redis:alpine
    ports:
      - "6379:6379"
